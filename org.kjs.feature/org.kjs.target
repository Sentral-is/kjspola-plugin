<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<?pde?>
<!--
  Target platform for building org.kjs.pola against iDempiere 13.

  Composed from the local iDempiere 13 checkout's own target-platform
  definitions rather than a standalone p2 repo, because iDempiere's core
  bundles (org.adempiere.base, org.adempiere.ui, org.adempiere.ui.zk, ...)
  are not published as a separate p2 site - they are plain source projects
  built as siblings in iDempiere's own Tycho reactor. Resolve this target,
  then import the projects from the idempiere-13 checkout below into the
  same Eclipse workspace so PDE can satisfy Require-Bundle against them.

  NOTE: the file: locations below are machine-specific absolute paths into
  a sibling checkout outside this repo (Windows path, since Eclipse runs
  natively on Windows here). They will not resolve on another machine or
  in CI as-is - update them to match wherever the idempiere-13 checkout
  lives locally.
-->
<target name="org.kjs.pola - iDempiere 13" sequenceNumber="1">
	<locations>
		<location type="Target" uri="file:/E:/Code/Addison/polacup/idempiere-13/org.idempiere.p2.targetplatform/base.target"/>
		<location type="Target" uri="file:/E:/Code/Addison/polacup/idempiere-13/org.idempiere.p2.targetplatform/maven.locations.target"/>
		<location type="Target" uri="file:/E:/Code/Addison/polacup/idempiere-13/org.idempiere.p2.targetplatform/bouncy.castle.target"/>
	</locations>
</target>
